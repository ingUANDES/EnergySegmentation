@article{dasgupta_perceptions_2022,
	title = {Perceptions, biases, and inequality},
	volume = {202},
	issn = {0167-2681},
	url = {https://www.sciencedirect.com/science/article/pii/S016726812200275X},
	doi = {10.1016/j.jebo.2022.08.003},
	abstract = {This paper introduces perceived self-efficacy beliefs in an overlapping generations model and studies the effects of behavioral anomalies on human capital investments and aggregate inequality. These beliefs are not inherent but based on a person’s socio-economic background. Ex ante children are homogeneous, but parents are biased about the returns to their children’s education. Based on parental education and job status, parents may be over or under confident but otherwise, they are rational. We witness spillover effects that shift the incentives to educate children from the pessimistic parents to unbiased parents. Biases may induce or hinder investment. Over investment by one parent type may even crowd-out investments of other parent types. We find interesting effects of biases on the aggregate economy when parental warm glow is not low.},
	language = {en},
	urldate = {2022-10-19},
	journal = {Journal of Economic Behavior \& Organization},
	author = {Dasgupta, Dyotona and Saha, Anuradha},
	month = oct,
	year = {2022},
	keywords = {Behavioral bias, Behavioral inequality, Human capital investment, Intergenerational mobility},
	pages = {198--210},
}

@article{lopez_climate_2022,
	title = {Climate change in times of economic uncertainty: {A} perverse tragedy of the commons?},
	volume = {75},
	issn = {0313-5926},
	shorttitle = {Climate change in times of economic uncertainty},
	url = {https://www.sciencedirect.com/science/article/pii/S0313592622000728},
	doi = {10.1016/j.eap.2022.05.005},
	abstract = {We explore the effect of raising economic uncertainty on local and global carbon emissions. Most economic models under uncertainty focus on the effect of risk on the supply of a control variable (e.g., emissions). Here we explore the effect of risk on both the supply and demand of local and global carbon emissions and, therefore, on their equilibrium shadow price. We show that in addition to the consumers’ level of risk aversion and prudence coefficient, an additional parameter not included in standard models, the elasticity of substitution between pollution and conventional inputs, plays a key role as a determinant of local and global emissions. An important implication of the analysis is that, under various specifications widely used for preferences and production technologies, a damning vicious cycle between increasing economic uncertainty and global pollution emissions is likely to occur.},
	language = {en},
	urldate = {2022-10-19},
	journal = {Economic Analysis and Policy},
	author = {Lopez, Ramon E. and Pastén, Roberto and Gutiérrez Cubillos, Pablo},
	month = sep,
	year = {2022},
	keywords = {Climate change, Cross prudence, Elasticity of factor substitution, Higher-order risk attitudes, Prudence, Risk aversion, Uncertainty},
	pages = {209--225},
}

@article{bramoulle_can_2009,
	title = {Can {Uncertainty} {Alleviate} the {Commons} {Problem}?},
	volume = {7},
	issn = {1542-4766},
	url = {http://www.jstor.org/stable/40282799},
	abstract = {Global commons problems, such as climate change, are often affected by severe uncertainty. The paper examines the effect of uncertainty on pollution emissions and welfare in a strategic context. We find that emissions are always lower under uncertainty than under certainty, reflecting risk-reducing considerations. We show that uncertainty can have a net positive impact on the welfare of risk-averse polluters. We extend the analysis to increases in risk, increases in risk-aversion, and to risk heterogeneity.},
	number = {5},
	urldate = {2022-10-14},
	journal = {Journal of the European Economic Association},
	author = {Bramoullé, Yann and Treich, Nicolas},
	year = {2009},
	note = {Publisher: Oxford University Press},
	pages = {1042--1067},
}

@article{venel_regularity_2021,
	title = {Regularity of dynamic opinion games},
	volume = {126},
	issn = {0899-8256},
	url = {https://www.sciencedirect.com/science/article/pii/S0899825621000105},
	doi = {10.1016/j.geb.2020.12.007},
	abstract = {We analyze a class of stochastic games where two lobbies compete by influencing the opinions in a society. We assume that the opinions evolve according to De Groot opinion formation and that the decisions of the lobbies change the structure of the network representing the society. We show that the regularity of discounted Nash equilibrium payoffs when players become patient is highly model-dependent. We provide two extreme cases. First, we present an example where the sequence of discounted Nash equilibrium payoffs does not converge. Hence, the solution is highly sensitive to the discount factor and a modeler needs to know the discount factor precisely in order to compute equilibria. Second, we focus on a subclass of problems where lobbies are restricted and show the existence of a uniform equilibrium. Hence, in this restricted framework, a modeler can predict some approximate equilibria with an imprecise knowledge of the discount factor.},
	language = {en},
	urldate = {2022-10-06},
	journal = {Games and Economic Behavior},
	author = {Venel, Xavier},
	month = mar,
	year = {2021},
	keywords = {Dynamic games, Game theory, Social network, Stochastic games, Targeting},
	pages = {305--334},
}

