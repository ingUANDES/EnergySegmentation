@article{grujic_rational_nodate,
	title = {Rational inattention in mice},
	volume = {8},
	issn = {2375-2548},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8896787/},
	doi = {10.1126/sciadv.abj8935},
	abstract = {Behavior exhibited by humans and other organisms is generally inconsistent and biased and, thus, is often labeled irrational. However, the origins of this seemingly suboptimal behavior remain elusive. We developed a behavioral task and normative framework to reveal how organisms should allocate their limited processing resources such that sensory precision and its related metabolic investment are balanced to guarantee maximal utility. We found that mice act as rational inattentive agents by adaptively allocating their sensory resources in a way that maximizes reward consumption in previously unexperienced stimulus-reward association environments. Unexpectedly, perception of commonly occurring stimuli was relatively imprecise; however, this apparent statistical fallacy implies “awareness” and efficient adaptation to their neurocognitive limitations. Arousal systems carry reward distribution information of sensory signals, and distributional reinforcement learning mechanisms regulate sensory precision via top-down normalization. These findings reveal how organisms efficiently perceive and adapt to previously unexperienced environmental contexts within the constraints imposed by neurobiology., Computational models reveal that apparently irrational behavior in fact reflects efficient adaptation to biological limitations.},
	number = {9},
	urldate = {2023-06-28},
	journal = {Science Advances},
	author = {Grujic, Nikola and Brus, Jeroen and Burdakov, Denis and Polania, Rafael},
	pmid = {35245128},
	pmcid = {PMC8896787},
	pages = {eabj8935},
}

@article{bartos_attention_2016,
