	month = dec,
	year = {2016},
	keywords = {Cap-and-trade, Electricity sector, Financial constraints, Investment, Permit allocation, Permit holdings, US SO2SO2{\textbackslash}hbox \{SO\}\_2 program},
	pages = {841--864},
}

