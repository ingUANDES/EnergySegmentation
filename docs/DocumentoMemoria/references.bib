@article{aumann_cooperative_1974,
	title = {Cooperative games with coalition structures},
	volume = {3},
	issn = {0020-7276, 1432-1270},
	url = {http://link.springer.com/article/10.1007/BF01766876},
	doi = {10.1007/BF01766876},
	abstract = {Many game-theoretic solution notions have been defined or can be defined not only with reference to the all-player coalition, but also with reference to an arbitrary coalition structure. In this paper, theorems are established that connect a given solution notion, defined for a coalition structure ℬ with the same solution notion applied to appropriately defined games on each of the coalitions in ℬ. This is done for the kernel, nucleolus, bargaining set, value, core, and thevon Neumann-Morgenstern solution. It turns out that there is a single function that plays the central role in five out of the six solution notions in question, though each of these five notions is entirely different. This is an unusual instance of a game theoretic phenomenon that does not depend on a particular solution notion but holds across a wide class of such notions.},
	language = {en},
	number = {4},
	urldate = {2016-10-11},
	journal = {International Journal of Game Theory},
