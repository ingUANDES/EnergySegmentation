@article{sandroni_markets_2000,
	title = {Do {Markets} {Favor} {Agents} able to {Make} {Accurate} {Predictions}?},
	volume = {68},
	copyright = {Econometric Society 2000},
	issn = {1468-0262},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/1468-0262.00163},
	doi = {10.1111/1468-0262.00163},
	abstract = {Blume and Easley (1992) show that if agents' have the same savings rule, those who maximize the expected logarithm of next period's outcomes will eventually hold all wealth (i.e. are ‘most prosperous’). However, if no agent adopts this rule then the most prosperous are not necessarily those who make the most accurate predictions. Thus, agents who make inaccurate predictions need not be driven out of the market. In this paper, it is shown that, among agents who have the same intertemporal discount factor (and who choose savings endogenously), the most prosperous are those who make accurate predictions. Hence, convergence to rational expectations obtains because agents who make inaccurate predictions are driven out of the market.},
	language = {en},
	number = {6},
	urldate = {2024-07-13},
	journal = {Econometrica},
	author = {Sandroni, Alvaro},
	year = {2000},
	keywords = {Rational expectations, learning, wealth accumulation.},
	pages = {1303--1341},
}

@article{krueger_pareto-improving_2006,
	title = {Pareto-{Improving} {Social} {Security} {Reform} when {Financial} {Markets} are {Incomplete}!?},
	volume = {96},
	issn = {0002-8282},
	url = {https://www-aeaweb-org.uandes.idm.oclc.org/articles?id=10.1257/aer.96.3.737},
	doi = {10.1257/aer.96.3.737},
	abstract = {This paper studies an overlapping generations model with stochastic production
and incomplete markets to assess whether the introduction of an unfunded social
security system leads to a Pareto improvement. When returns to capital and wages
are imperfectly correlated, a system that endows retired households with claims to
labor income enhances the sharing of aggregate risk between generations. Our
quantitative analysis shows that, abstracting from the capital crowding-out effect,
the introduction of social security represents a Pareto-improving reform, even when
the economy is dynamically efficient. However, the severity of the crowding-out
effect in general equilibrium tends to overturn these gains. (JEL D58, D91, E62,
H31, H55)},
	language = {en},
	number = {3},
	urldate = {2024-07-12},
	journal = {American Economic Review},
	author = {Krueger, Dirk and Kubler, Felix},
	month = jun,
	year = {2006},
	keywords = {Intertemporal Household Choice, Life Cycle Models and Saving, Social Security and Public Pensions},
	pages = {737--755},
}

