@article{billette_de_villemeur_explications_2023,
	title = {Explications et équivalence observationnelle : quelques questions à partir d’un modèle économique simple du comportement:},
	volume = {Volume 30},
	issn = {1279-7243},
	shorttitle = {Explications et équivalence observationnelle},
	url = {https://www.cairn.info/revue-bulletin-d-histoire-et-d-epistemologie-des-sciences-de-la-vie-2023-1-page-35.htm?ref=doi},
	doi = {10.3917/bhesv.301.0035},
	abstract = {Supposons une « explication parfaite », c’est-à-dire un modèle causal qui associe à chaque ensemble de paramètres une unique conséquence. Supposons également cette explication précise et sans ambiguïté : des conséquences différentes sont toujours associées à des valeurs de paramètres différentes – et vice-versa . Doit-on pour autant être satisfait ? Nous montrons à l’aide d’un exemple simple que plusieurs « explications parfaites » peuvent coexister ; et plus généralement qu’il existe des explications « équivalentes » du point de vue observationnel, sans que cela soit une conséquence de l’existence de données limitées ou d’observations imparfaites. Par définition, des explications ayant un même pouvoir de prédiction ne peuvent se distinguer sur la base des seules observations qu’elles expliquent. Cette impossibilité pose question quant au statut à attribuer à leurs ( a priori différentes) implications. Dans tous les cas, quelle que soit la quantité de données, les observations ne permettent qu’un classement partiel d’explications concurrentes.},
	language = {en-US},
	number = {1},
	urldate = {2024-11-20},
	journal = {Bulletin d’histoire et d’épistémologie des sciences de la vie},
	author = {Billette De Villemeur, Etienne},
	month = may,
	year = {2023},
	pages = {35--45},
}

@book{jeet_learning_2017,
