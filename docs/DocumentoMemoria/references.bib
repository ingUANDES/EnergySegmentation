@article{harvey_investors_2022,
	title = {An {Investor}’s {Guide} to {Crypto}},
	volume = {49},
	copyright = {© 2022 Pageant Media Ltd},
	issn = {0095-4918, 2168-8656},
	url = {https://jpm.pm-research.com/content/49/1/146},
	doi = {10.3905/jpm.2022.1.428},
	abstract = {The authors provide practical insights for investors seeking exposure to the growing cryptocurrency space. Today, crypto is much more than just bitcoin, which historically dominated the space but accounted for just a 31\% share of total crypto trading volume in June 2022. The authors discuss a wide variety of tokens, highlighting both their functionality and their investment properties. The authors critically compare popular valuation methods, and they contrast buy-and-hold investing with more active styles. The authors only deem return data from 2017 representative, but the use of intraday data boosts statistical power. Underlying crypto performance has been notoriously volatile, but volatility-targeting methods are effective at controlling risk, and trend-following strategies have performed well. Crypto assets display a low correlation with traditional risky assets in normal times, but the correlation also rises in the left tail of these risky assets. Finally, the authors detail important custody and regulatory considerations for institutional investors.},
	language = {en},
	number = {1},
	urldate = {2022-11-02},
	journal = {The Journal of Portfolio Management},
	author = {Harvey, Campbell R. and Zeid, Tarek Abou and Draaisma, Teun and Luk, Martin and Neville, Henry and Rzym, Andre and Hemert, Otto Van},
	month = oct,
	year = {2022},
	note = {Publisher: Institutional Investor Journals Umbrella},
	pages = {146--171},
}

