	journal = {International Economic Review},
	author = {Crockett, Sean and Friedman, Daniel and Oprea, Ryan},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/iere.12500},
}

@article{braun_does_2019,
