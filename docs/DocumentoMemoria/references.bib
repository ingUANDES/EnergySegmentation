@book{mansuy_f_2018,
	title = {F. {A}. {Hayek}: {Dos} ensayos sobre economía y moral},
	shorttitle = {F. {A}. {Hayek}},
	abstract = {El pensamiento de Friedrich Hayek constituye uno de los esfuerzos más sistemáticos por proveer de fundamentos filosóficos a un orden liberal articulado en torno al mercado. A pesar de que su obra cobró especial importancia en Chile a fines del siglo pasado, poco se ha escrito en nuestro medio sobre el autor de Camino de servidumbre. Retomar sus inquietudes e identificar las tensiones internas en su obra podría brindar nueva luz a los debates que ha experimentado nuestro país desde 2011 en adelante. F. A. Hayek. Dos ensayos sobre economía y moral pretende contribuir a la reflexión pendiente sobre el Nobel austríaco. En diálogo con la obra de este pensador, Daniel Mansuy y Matías Petersen ponen sobre la mesa algunos de los problemas que Hayek trató y que guardan directa relación con nuestras discusiones actuales: el lugar del mercado en la vida social, la relación entre mercado y moralidad y el tipo de gobierno político que admite la economía contemporánea, entre otros. No es seguro que las respuestas ofrecidas por Friedrich Hayek resuelvan todos nuestros dilemas, pero recuperar sus preguntas fundamentales nos ayuda sin duda a enfrentarlos.},
	language = {Español},
	author = {Mansuy, Daniel and Petersen, Matías},
	year = {2018},
}

