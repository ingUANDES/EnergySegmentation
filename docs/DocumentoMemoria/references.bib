	url = {https://doi.org/10.1007/978-3-642-61521-4_5},
	abstract = {In this final chapter, we turn to the other major paradigm in general equilibrium theory: the overlapping generations (OLG) model. The OLG models are extensions and elaborations of P. A. Samuelson’s celebrated pure consumption loan model [59]. Unlike the Arrow—Debreu model which has its genesis in the work of L. Walras [67], Samuelson’s model derives from I. Fisher’s classic monograph The Theory of Interest [28]. As such it shares its origins with the models of T. F. Bewley [16] and B. Peleg and M. E. Yaari [53].},
	language = {en},
