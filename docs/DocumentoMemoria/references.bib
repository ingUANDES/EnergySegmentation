@article{won_new_2023,
	title = {A new approach to the uniqueness of equilibrium with {CRRA} preferences},
	volume = {208},
	issn = {0022-0531},
	url = {https://www.sciencedirect.com/science/article/pii/S0022053123000030},
	doi = {10.1016/j.jet.2023.105607},
	abstract = {This paper investigates the uniqueness of equilibrium in the economy where agents have preferences with possibly distinct levels of relative risk aversion. Equilibrium prices exist in a price range determined by micro and macroeconomic information. Macroeconomic information is inferred from two representative-agent economies, which provide lower and upper bounds on aggregate demand, respectively. Analysis of the first and second-order price effects shows that individual demand has a unique inflection point at which the income effect maximally dominates the substitution effect. In contrast, aggregate demand may have multiple inflection points, which creates multiple equilibria. Sufficient conditions for the uniqueness of equilibrium are characterized by the local behavior of individual demand at the inflection point. They require that aggregate demand must have no more than two inflection points in the equilibrium price range. The result of this paper sheds light on the Sonnenschein-Mantel-Debreu theory that has negative implications for the uniqueness of equilibrium.},
	urldate = {2024-02-07},
	journal = {Journal of Economic Theory},
	author = {Won, Dong Chul},
	month = mar,
	year = {2023},
	keywords = {Constant relative risk aversion, Higher-order price effect, Law of demand, Quasi-convex demand, Unique equilibrium},
	pages = {105607},
}

