	issn = {0033-5533},
	url = {http://www.jstor.org/stable/40506220},
	abstract = {Research on information economics and securities markets dating back to Stigler (Journal of Political Economy, 69 (1961), 213-225; Journal of Business, 37 (1964), 117-142) argues that trading will tend to centralize in major market centers such as the New York Stock Exchange (NYSE). The NYSE's recent mergers with Archipelago and Euronext bring questions about the viability and effects of competition between stock exchanges to the policy forefront. We examine the largely forgotten but unparalleled episode of competition between the NYSE and the Consolidated Stock Exchange of New York (Consolidated) from 1885 to 1926. The Consolidated averaged 23\% of NYSE volume for approximately forty years by operating a second market for the most liquid securities that traded on the Big Board. Our results suggest that NYSE bid-ask spreads fell by more than 10\% when the Consolidated began to trade NYSE stocks and subsequently increased when the Consolidated ceased operations. The empirical analysis suggests that this historical episode of stock market competition improved consumer welfare by an amount equivalent to US\$9.6 billion today.},
	number = {4},
	urldate = {2015-02-25},
	journal = {The Quarterly Journal of Economics},
	author = {Brown, Jr., William O. and Mulherin, J. Harold and Weidenmier, Marc D.},
	month = nov,
	year = {2008},
	pages = {1679--1719},
}

@article{zigrand_general_2004,
	title = {A general equilibrium analysis of strategic arbitrage},
	volume = {40},
	issn = {0304-4068},
	url = {http://www.sciencedirect.com/science/article/pii/S0304406803001344},
	doi = {10.1016/j.jmateco.2003.09.002},
	abstract = {We analyze a general equilibrium framework with Cournot arbitrageurs and with price-taking investors who are subjected to restricted participation constraints. Restricted participation may leave some arbitrage opportunities unexploited by investors.

We show existence of Cournot–Walras equilibria with an endogenous number of arbitrageurs. The number of arbitrageurs is endogenous since they have to sink entry costs in order to arbitrage across the relevant markets. We characterize equilibria and analyze the effects on equilibrium prices and quantities of increased competition among arbitrageurs due to lower entry costs.},
	number = {8},
	urldate = {2015-02-25},
	journal = {Journal of Mathematical Economics},
	author = {Zigrand, Jean-Pierre},
	month = dec,
	year = {2004},
	keywords = {Arbitrage, Cournot–Walras, General equilibrium, Restricted participation},
	pages = {923--952},
}

@article{bisin_competitive_1999,
	title = {Competitive {Equilibria} with {Asymmetric} {Information}},
	volume = {87},
	issn = {0022-0531},
	url = {http://www.sciencedirect.com/science/article/pii/S0022053199925140},
	doi = {10.1006/jeth.1999.2514},
	abstract = {This paper studies competitive equilibria in economies where agents trade in markets for standardized, non-exclusive financial contracts, under conditions of asymmetric information (both of the moral hazard and the adverse selection type). The problems for the existence of competitive equilibria in this framework are identified, and shown to be essentially the same under different forms of asymmetric information. We then show that a “minimal” form of non-linearity of prices (a bid-ask spread, requiring only the possibility to separate buyers and sellers), and the condition that the aggregate return on the individual positions in each contract can be perfectly hedged in the existing markets, ensure the existence of competitive equilibria in the case of both adverse selection and moral hazard. Journal of Economic Literature Classification Numbers: D50, D82.},
	number = {1},
	urldate = {2015-02-25},
	journal = {Journal of Economic Theory},
	author = {Bisin, Alberto and Gottardi, Piero},
	month = jul,
	year = {1999},
	pages = {1--48},
}

@article{scotchmer_consumption_2005,
	title = {Consumption externalities, rental markets and purchase clubs},
	volume = {25},
	issn = {0938-2259, 1432-0479},
	url = {http://link.springer.com/article/10.1007/s00199-004-0506-4},
	doi = {10.1007/s00199-004-0506-4},
	abstract = {A premise of general equilibrium theory is that private goods are rival. Nevertheless, many private goods are shared, e.g., through borrowing, through co-ownership, or simply because one person’s consumption affects another person’s wellbeing. I analyze consumption externalities from the perspective of club theory, and argue that, provided consumption externalities are limited in scope, they can be internalized through membership fees to groups. Two important applications are to rental markets and “purchase clubs,” in which members share the goods that they have individually purchased.},
	language = {en},
	number = {1},
	urldate = {2015-02-25},
	journal = {Economic Theory},
	author = {Scotchmer, Suzanne},
	month = jan,
	year = {2005},
	keywords = {Clubs, Consumption externalities, Purchase clubs, Rental markets.},
	pages = {235--253},
}

@article{prescott_firms_2006,
	title = {Firms as {Clubs} in {Walrasian} {Markets} with {Private} {Information}},
	volume = {114},
	copyright = {Copyright © 2006 The University of Chicago Press},
	issn = {0022-3808},
	url = {http://www.jstor.org/stable/10.1086/505231},
	doi = {10.1086/505231},
	abstract = {We incorporate multiagent, principal‐agent theory into general equilibrium analysis. The traded commodities are multiagent contracts that include a description of the individual’s job, effort level, and state‐contingent consumption. These contracts are club goods. The competitive equilibrium and the Pareto program are formulated. The contracts are identified with firms, so the market determines which firms exist and who is assigned to which firm in what capacity. An example is provided in which the internal organization of firms and the distribution of firm classes vary with the aggregate capital endowment and its distribution across agents. A simplex‐based algorithm for solving the Pareto program is developed.},
	number = {4},
	urldate = {2015-02-25},
	journal = {Journal of Political Economy},
	author = {Prescott, Edward Simpson and Townsend, Robert M.},
	month = aug,
	year = {2006},
	pages = {644--671},
}

@article{ellickson_clubs_1999,
	title = {Clubs and the {Market}},
	volume = {67},
	copyright = {Copyright © 1999 The Econometric Society},
	issn = {0012-9682},
	url = {http://www.jstor.org/stable/2999516},
	abstract = {This paper defines a general equilibrium model with exchange and club formation. Agents trade multiple private goods widely in the market, can belong to several clubs, and care about the characteristics of the other members of their clubs. The space of agents is a continuum, but clubs are finite. It is shown that (i) competitive equilibria exist, and (ii) the core coincides with the set of equilibrium states. The central subtlety is in modeling club memberships and expressing the notion that membership choices are consistent across the population.},
	number = {5},
	urldate = {2015-02-25},
	journal = {Econometrica},
	author = {Ellickson, Bryan and Grodal, Birgit and Scotchmer, Suzanne and Zame, William R.},
	month = sep,
	year = {1999},
	pages = {1185--1217},
}

@article{kaneko_core_1989,
	title = {The core of a continuum economy with widespread externalities and finite coalitions: {From} finite to continuum economies},
	volume = {49},
	issn = {0022-0531},
	shorttitle = {The core of a continuum economy with widespread externalities and finite coalitions},
	url = {http://www.sciencedirect.com/science/article/pii/0022053189900719},
	doi = {10.1016/0022-0531(89)90071-9},
	abstract = {When permissible coalitions in finite economies are constrained to be small relative to the player set, the continuum model with finite coalitions and its f-core are the limits of large finite economies and their ε-cores. We show convergence both of game-theoretic structures—relatively small coalitions in the finite economies converge to finite coalitions-and of solutions—ε-cores converge to the f-core. Our convergence is carried out in the context of exchange economies with widespread externalities where the requirement that coalitions be small is critical.},
