@article{back_concepts_1986,
	title = {Concepts of similarity for utility functions},
	volume = {15},
	issn = {0304-4068},
	url = {http://www.sciencedirect.com/science/article/pii/0304406886900042},
	doi = {10.1016/0304-4068(86)90004-2},
	abstract = {A generalization of the compact-open topology is defined for a space of utility functions with different choice sets. The space is a complete separable metric space. A continuous representation theorem of Levin (1983) gives a homeomorphism between this space and the space of preference relations, topologized by closed convergence. A map into the space is measurable with regard to the Borel algebra iff the choice set correspondence is measurable and the utility function is measurable on its graph. A coarser topology (that of subgraph convergence) is also studied. This topology is coarser than the compact-open topology when the utility functions are defined on the same choice set. However the demand correspondence is still upper-hemicontinuous. A homeomorphism is given between this space and the space of preference relations, with the latter given a certain topology coarser than closed convergence.},
	number = {2},
	urldate = {2018-08-11},
	journal = {Journal of Mathematical Economics},
	author = {Back, Kerry},
	month = jan,
	year = {1986},
	pages = {129--142},
}

@article{khan_relaxed_2016,
	title = {Relaxed large economies with infinite-dimensional commodity spaces: {The} existence of {Walrasian} equilibria},
	volume = {67},
	issn = {0304-4068},
	shorttitle = {Relaxed large economies with infinite-dimensional commodity spaces},
	url = {http://www.sciencedirect.com/science/article/pii/S0304406816301422},
	doi = {10.1016/j.jmateco.2016.09.004},
	abstract = {Whereas “convexification by aggregation” is a well-understood procedure in mathematical economics, “convexification by randomization” has largely been limited to theories of statistical decision-making, optimal control and non-cooperative games. In this paper, in the context of classical Walrasian general equilibrium theory, we offer a comprehensive treatment of relaxed economies and their relaxed Walrasian equilibria: our results pertain to a setting with a finite or a continuum of agents, and a continuum of commodities modeled either as an ordered separable Banach space or as an L∞-space. As a substantive consequence, we demonstrate that the convexity hypothesis can be removed from the original large economy under the saturation hypothesis, and that existing results in the antecedent literature can be effortlessly recovered.},
	urldate = {2018-08-11},
	journal = {Journal of Mathematical Economics},
	author = {Khan, M. Ali and Sagara, Nobusumi},
	month = dec,
	year = {2016},
	keywords = {Lyapunov convexity theorem, Purification principle, Relaxed control, Relaxed large economy, Saturated measure space, Walrasian equilibrium},
	pages = {95--107},
}

