	publisher = {Cambridge University Press},
	author = {Adler, Matthew D. and Decancq, Koen},
	editor = {Adler, Matthew D. and Norheim, Ole F.},
	year = {2022},
	doi = {10.1017/9781108691734.003},
	keywords = {capabilities, equivalence approach, equivalent income, interpersonal comparisons, money-metric well-being, preference, prioritarianism, subjective well-being (SWB), von Neumann-Morgenstern (vNM) utility, well-being measurement},
	pages = {128--171},
}

