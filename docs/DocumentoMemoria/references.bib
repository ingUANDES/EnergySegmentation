	author = {Allcott, Hunt and Taubinsky, Dmitry},
	month = aug,
	year = {2015},
	keywords = {Belief, Communication, Consumer Economics: Empirical Analysis, Search, Household Goods, Information and Knowledge, Learning, Optimal Taxation, Fiscal Policies and Behavior of Economic Agents: Household, Other Consumer Nondurables: Clothing, Textiles, Shoes, and Leather Goods, Prices, Energy: Government Policy, Sports Equipment, Energy: Demand and Supply, Unawareness, Taxation and Subsidies: Efficiency},
	pages = {2501--2538},
}

@article{dittmar_public_2020,
	title = {Public {Goods} {Institutions}, {Human} {Capital}, and {Growth}: {Evidence} from {German} {History}},
	volume = {87},
	issn = {0034-6527},
	shorttitle = {Public {Goods} {Institutions}, {Human} {Capital}, and {Growth}},
	url = {https://doi.org/10.1093/restud/rdz002},
	doi = {10.1093/restud/rdz002},
	abstract = {What are the origins and consequences of the state as a provider of public goods? We study public goods provision established through new laws in German cities during the 1500s. Cities that adopted the laws subsequently began to differentially produce and attract human capital and to grow faster. Legal change occurred where ideological competition introduced by the Protestant Reformation interacted with local politics. We study plagues that shifted local politics in a narrow period as sources of exogenous variation in public goods institutions, and find support for a causal interpretation of the relationship between legal change, human capital, and growth.},
	number = {2},
	urldate = {2021-03-18},
	journal = {The Review of Economic Studies},
	author = {Dittmar, Jeremiah E and Meisenzahl, Ralf R},
