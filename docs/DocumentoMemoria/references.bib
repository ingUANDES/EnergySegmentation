	url = {http://gateway.webofknowledge.com/gateway/Gateway.cgi?GWVersion=2&SrcAuth=DOISource&SrcApp=WOS&KeyAID=10.1093%2Frfs%2Fhhy068&DestApp=DOI&SrcAppSID=6BmfkGS2ZZCX5ByBTNG&SrcJTitle=REVIEW+OF+FINANCIAL+STUDIES&DestDOIRegistrantName=Oxford+University+Press},
