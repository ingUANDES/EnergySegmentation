@article{chavas_efficiency_2019,
	title = {Efficiency under {Uncertainty} and {Non}-convexity: {Evaluating} the {Role} of {Probabilities}},
	volume = {86},
	copyright = {© 2018 The London School of Economics and Political Science},
	issn = {1468-0335},
	shorttitle = {Efficiency under {Uncertainty} and {Non}-convexity},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ecca.12293},
