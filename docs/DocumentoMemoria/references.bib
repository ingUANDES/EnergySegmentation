@article{gui_mutual_2009,
	title = {{ON} {MUTUAL} {BENEFIT} {AND} {SACRIFICE}: {A} {COMMENT} {ON} {BRUNI} {AND} {SUGDEN}'{S} ‘{FRATERNITY}’},
	volume = {25},
	issn = {1474-0028, 0266-2671},
	shorttitle = {{ON} {MUTUAL} {BENEFIT} {AND} {SACRIFICE}},
	url = {https://www.cambridge.org/core/journals/economics-and-philosophy/article/abs/on-mutual-benefit-and-sacrifice-a-comment-on-bruni-and-sugdens-fraternity/95BAA8D94DA74C182F1FC6947837D2C9},
	doi = {10.1017/S0266267109990046},
	abstract = {This note comments on Bruni and Sugden's interesting notion of fraternity among contract partners as joint commitment to cooperate for mutual benefit. I raise two points on their paper, both concerning the role of sacrifice. First I maintain that, differently from other social preferences, guilt aversion (or warm glow) does not imply self-sacrifice. Secondly, I argue that aiming for mutual benefit does not prevent individuals from facing trade-offs between their own and their partners’ surplus, so the notion of sacrifice cannot be entirely eschewed. To the contrary, reciprocal ‘sacrifices’ enhance cooperative intentions and help create feelings of friendliness.},
	language = {en},
	number = {2},
	urldate = {2025-07-03},
	journal = {Economics \& Philosophy},
	author = {Gui, Benedetto},
	month = jul,
	year = {2009},
	pages = {179--185},
}

