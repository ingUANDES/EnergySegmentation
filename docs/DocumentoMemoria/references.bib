@article{ottoni-wilhelm_why_2017,
	title = {Why {Do} {People} {Give}? {Testing} {Pure} and {Impure} {Altruism}},
	volume = {107},
	issn = {0002-8282},
	shorttitle = {Why {Do} {People} {Give}?},
	url = {https://pubs.aeaweb.org/doi/10.1257/aer.20141222},
	doi = {10.1257/aer.20141222},
	abstract = {Researchers measure crowd-out around one level of charity output to identify whether giving is motivated by altruism and/or warm-glow. However, crowd-out depends on output, implying first that the power to reject pure altruism varies, and second that a single measurement of incomplete crowd-out can be rationalized by many different preferences. By instead measuring crowd-out at different output levels, we allow both for identification and for a novel and direct test of impure altruism. Using a new experimental design, we present the first empirical evidence that, consistent with impure altruism, crowd-out decreases with output. (JEL D64, L31)},
	language = {en},
	number = {11},
	urldate = {2025-02-25},
	journal = {American Economic Review},
	author = {Ottoni-Wilhelm, Mark and Vesterlund, Lise and Xie, Huan},
	month = nov,
